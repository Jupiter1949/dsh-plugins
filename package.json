{
  "name": "dsh-cot-smart",
  "description": "Dynamic CoT for DeepSeek Harness: set adapter reasoningEffort per request by input complexity — off for easy/short prompts, high/max for code, tables, math, or strong-reasoning asks. Saves thinking tokens without sacrificing quality.",
  "version": "1.0.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-llm": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-agent": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true }
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "plugin",
    "chain-of-thought",
    "cot",
    "reasoning",
    "thinking"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
